if(state[117] != state[125]) total=total+(-1);
if(state[119] != state[127]) total=total+(-1);
if(state[120] != state[124]) total=total+(2);
if(state[120] != state[126]) total=total+(-1);
if(state[120] != state[127]) total=total+(1);
if(state[121] != state[124]) total=total+(1);
if(state[121] != state[125]) total=total+(-1);
if(state[122] != state[124]) total=total+(-2);
if(state[122] != state[125]) total=total+(-2);
if(state[122] != state[126]) total=total+(-1);
if(state[122] != state[127]) total=total+(-1);
if(state[123] != state[124]) total=total+(1);
if(state[123] != state[125]) total=total+(-2);
if(state[123] != state[126]) total=total+(2);
if(state[123] != state[127]) total=total+(1);
score=total[15:0];
end
endfunction
